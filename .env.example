# ==============================================================================
# Environment Configuration
# ==============================================================================

# App Settings
APP_NAME="SocialHabit API"
APP_VERSION="2.0.0"
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://mauro:1234@localhost:5432/socialhabit
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 Tage

# CORS Settings (komma-separiert)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# APNs (Push Notifications)
APNS_ENABLED=false
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_USE_SANDBOX=true

# Feature Flags
FEATURE_ADMIN_PANEL=true
FEATURE_PUSH_NOTIFICATIONS=false
FEATURE_EMAIL_NOTIFICATIONS=false
